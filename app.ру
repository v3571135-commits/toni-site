@app.route('/api/chats/<int:my_id>', methods=['GET'])
def get_chats(my_id):
    messages = Message.query.filter((Message.sender_id == my_id) | (Message.receiver_id == my_id)).all()
    chat_ids = set()
    for m in messages:
        if m.sender_id != my_id: chat_ids.add(m.sender_id)
        if m.receiver_id != my_id: chat_ids.add(m.receiver_id)
    
    result = []
    for uid in chat_ids:
        user = db.session.get(User, uid)
        if user:
            unread_msgs = Message.query.filter_by(sender_id=uid, receiver_id=my_id, is_read=False).all()
            unread = len(unread_msgs) > 0
            
            last_msg = Message.query.filter_by(sender_id=uid, receiver_id=my_id).order_by(Message.id.desc()).first()
            last_msg_id = last_msg.id if last_msg else 0
            
            result.append({
                'id': user.id, 
                'name': user.name, 
                'username': user.username, 
                'avatar': user.avatar,
                'unread': unread,
                'last_msg_id': last_msg_id
            })
    return jsonify(result)

