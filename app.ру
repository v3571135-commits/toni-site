@app.route('/api/subscribe', methods=['POST'])
def subscribe():
    data = request.json
    # Проверяем, не подписан ли уже
    existing = Subscription.query.filter_by(subscriber_id=data['my_id'], target_id=data['target_id']).first()
    if existing:
        return jsonify({'error': 'Вы уже подписаны'})
    
    new_sub = Subscription(subscriber_id=data['my_id'], target_id=data['target_id'])
    target_user = db.session.get(User, data['target_id'])
    if target_user:
        target_user.subscribers += 1
    
    db.session.add(new_sub)
    db.session.commit()
    return jsonify({'status': 'ok'})

