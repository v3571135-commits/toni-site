@app.route('/')
def home():
    return render_template('index.html')

@app.route('/ask', methods=['POST'])
def ask():
    data = request.json
    user_text = data.get('text', '').lower().strip()
    
    # 1. Ищем точное совпадение
    if user_text in my_dict:
        return jsonify({'answer': my_dict[user_text]})
    
    # 2. Ищем ключевые слова (если вопрос длинный)
    for key in my_dict:
        if key in user_text:
            return jsonify({'answer': my_dict[key]})
            
    # 3. Если ничего не нашли
    return jsonify({'answer': "Я пока не знаю, что на это ответить. Я ведь работаю на простом словаре. Попробуй нажать на кнопки быстрых вопросов или спроси про 'профиль', 'рекомендации' или 'отзывы'."})

