@app.route('/ask', methods=['POST'])
def ask():
    data = request.json
    user_text = data.get('text', '').lower().strip()
    
    if user_text in my_dict:
        return jsonify({'answer': my_dict[user_text]})
    
    # Поиск по ключевым словам (если вопрос длинный)
    for key in my_dict:
        if key in user_text:
            return jsonify({'answer': my_dict[key]})
            
    return jsonify({'answer': "Хм, я пока не знаю, что на это ответить. Я работаю на словаре. Попробуй спросить про 'помощь', 'физику' или 'паука'."})

@app.route('/api/register', methods=['POST'])
def register():
    data = request.json
    if User.query.filter_by(username=data['username']).first():
        return jsonify({'error': 'Этот ID уже занят!'})
    
    # Шифруем пароль
    hashed_pw = generate_password_hash(data.get('password', '123'))
    
    new_user = User(
        username=data['username'], 
        name=data['name'], 
        email=data['email'], 
        password_hash=hashed_pw, 
        has_password=True, # При регистрации пароль сразу есть
        avatar=data['avatar']
    )
    db.session.add(new_user)
    db.session.commit()
    return jsonify({'status': 'ok', 'user_id': new_user.id})

@app.route('/api/set_password', methods=['POST'])
def set_password():
    data = request.json
    user = db.session.get(User, data['user_id'])
    if user:
        user.password_hash = generate_password_hash(data['password'])
        user.has_password = True
        db.session.commit()
        return jsonify({'status': 'ok', 'user_id': user.id, 'name': user.name, 'avatar': user.avatar, 'username': user.username})
    return jsonify({'error': 'Ошибка'})

@app.route('/api/update_profile', methods=['POST'])
def update_profile():
    data = request.json
    user = db.session.get(User, data['user_id'])
    
    if not user:
        return jsonify({'error': 'Пользователь не найден'})

    if data['field'] == 'name':
        user.name = data['value']
    elif data['field'] == 'avatar':
        user.avatar = data['value']
    elif data['field'] == 'username':
        # Проверяем, не занят ли новый ID
        if User.query.filter_by(username=data['value']).first():
            return jsonify({'error': 'Этот ID уже занят!'})
        user.username = data['value']
        
    db.session.commit()
    return jsonify({'status': 'ok'})

@app.route('/api/login', methods=['POST'])
def login():
    data = request.json
    user = User.query.filter_by(username=data['username']).first()
    
    if not user:
        return jsonify({'error': 'Пользователь не найден'})
        
    # Если у пользователя еще нет пароля (старый аккаунт)
    if not user.has_password:
        return jsonify({'need_password': True, 'user_id': user.id, 'name': user.name, 'avatar': user.avatar})
        
    # Если пароль есть, проверяем его
    if check_password_hash(user.password_hash, data['password']):
        return jsonify({'status': 'ok', 'user_id': user.id, 'name': user.name, 'avatar': user.avatar, 'username': user.username})
    else:
        return jsonify({'error': 'Неверный пароль'})

@app.route('/api/search_users', methods=['POST'])
def search_users():
    data = request.json
    query = data.get('query', '')
    users = User.query.filter((User.username.like(f'%{query}%')) | (User.name.like(f'%{query}%'))).all()
    return jsonify([{'id': u.id, 'username': u.username, 'name': u.name, 'avatar': u.avatar} for u in users])

