from flask import Flask, render_template, request, jsonify
from flask_sqlalchemy import SQLAlchemy

app = Flask(__name__)
app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///toni.db'
app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False
db = SQLAlchemy(app)

# Модели базы данных
class User(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    username = db.Column(db.String(50), unique=True, nullable=False)
    name = db.Column(db.String(50), nullable=False)
    avatar = db.Column(db.String(10), default='👤')

class Message(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    sender_id = db.Column(db.Integer, db.ForeignKey('user.id'), nullable=False)
    receiver_id = db.Column(db.Integer, db.ForeignKey('user.id'), nullable=False)
    text = db.Column(db.Text, nullable=False)

with app.app_context():
    db.create_all()

# Словарь
my_dict = {
    "привет": "Привет! Я Тони, твой помощник по сайту.",
    "как дела": "У меня всё отлично, я же программа!",
    "помощь": "Я умею отвечать на вопросы о сайте. Спроси про 'профиль', 'рекомендации' или 'настройки'.",
}

@app.route('/')
def home():
    return render_template('index.html')

@app.route('/ask', methods=['POST'])
def ask():
    data = request.json
    user_text = data.get('text', '').lower().strip()
    if user_text in my_dict:
        return jsonify({'answer': my_dict[user_text]})
    return jsonify({'answer': "Я пока не знаю, что на это ответить. Спроси про 'помощь'."})

# API для пользователей
@app.route('/api/register', methods=['POST'])
def register():
    data = request.json
    new_user = User(username=data['username'], name=data['name'], avatar=data['avatar'])
    try:
        db.session.add(new_user)
        db.session.commit()
        return jsonify({'status': 'ok', 'user_id': new_user.id})
    except:
        return jsonify({'error': 'Этот ID уже занят'})

@app.route('/api/search', methods=['POST'])
def search():
    data = request.json
    query = data.get('query', '')
    user = User.query.filter((User.username.contains(query)) | (User.name.contains(query))).first()
    if user:
        return jsonify({'id': user.id, 'username': user.username, 'name': user.name, 'avatar': user.avatar})
    return jsonify({'error': 'Пользователь не найден'})

@app.route('/api/messages', methods=['GET', 'POST'])
def messages():
    if request.method == 'POST':
        data = request.json
        new_msg = Message(sender_id=data['sender_id'], receiver_id=data['receiver_id'], text=data['text'])
        db.session.add(new_msg)
        db.session.commit()
        return jsonify({'status': 'ok'})
    else:
        sender = request.args.get('sender_id')
        receiver = request.args.get('receiver_id')
        msgs = Message.query.filter(
            ((Message.sender_id == sender) & (Message.receiver_id == receiver)) |
            ((Message.sender_id == receiver) & (Message.receiver_id == sender))
        ).all()
        return jsonify([{'sender_id': m.sender_id, 'text': m.text} for m in msgs])

