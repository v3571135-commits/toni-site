@app.route('/')
def home():
    return render_template('index.html')

@app.route('/ask', methods=['POST'])
def ask():
    data = request.json
    user_text = data.get('text', '').lower().strip()
    if user_text in my_dict:
        return jsonify({'answer': my_dict[user_text]})
    for key in my_dict:
        if key in user_text:
            return jsonify({'answer': my_dict[key]})
    return jsonify({'answer': "Я пока не знаю, что на это ответить. Спроси про 'помощь'."})

@app.route('/api/register', methods=['POST'])
def register():
    data = request.json
    if User.query.filter_by(username=data['username']).first():
        return jsonify({'error': 'Этот ID уже занят!'})
    
    new_user = User(
        username=data['username'], 
        name=data['name'], 
        email=data['email'], 
        password=data.get('password', '123'), 
        avatar=data['avatar']
    )
    db.session.add(new_user)
    db.session.commit()
    
    return jsonify({'status': 'ok', 'user_id': new_user.id})

@app.route('/api/search_users', methods=['POST'])
def search_users():
    data = request.json
    query = data.get('query', '')
    users = User.query.filter((User.username.like(f'%{query}%')) | (User.name.like(f'%{query}%'))).all()
    return jsonify([{'id': u.id, 'username': u.username, 'name': u.name, 'avatar': u.avatar, 'vintiki': u.vintiki} for u in users])

@app.route('/api/get_user/<int:user_id>')
def get_user(user_id):
    u = db.session.get(User, user_id)
    if u:
        return jsonify({'id': u.id, 'username': u.username, 'name': u.name, 'avatar': u.avatar, 'vintiki': u.vintiki, 'coins': u.coins})
    return jsonify({'error': 'Не найден'})

@app.route('/api/messages/<int:my_id>/<int:other_id>', methods=['GET'])
def get_messages(my_id, other_id):
    msgs = Message.query.filter(
        ((Message.sender_id == my_id) & (Message.receiver_id == other_id)) |
        ((Message.sender_id == other_id) & (Message.receiver_id == my_id))
    ).order_by(Message.id).all()
    return jsonify([{'sender': m.sender_id, 'text': m.text} for m in msgs])

@app.route('/api/messages/send', methods=['POST'])
def send_message():
    data = request.json
    new_msg = Message(sender_id=data['sender_id'], receiver_id=data['receiver_id'], text=data['text'])
    db.session.add(new_msg)
    db.session.commit()
    return jsonify({'status': 'ok'})

