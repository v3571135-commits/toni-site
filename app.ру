@app.route('/ask', methods=['POST'])
def ask():
    data = request.json
    user_text = data.get('text', '').lower().strip()
    
    if user_text in my_dict:
        return jsonify({'answer': my_dict[user_text]})
    
    # Поиск по ключевым словам (если вопрос длинный)
    for key in my_dict:
        if key in user_text:
            return jsonify({'answer': my_dict[key]})
            
    return jsonify({'answer': "Хм, я пока не знаю, что на это ответить. Я работаю на словаре. Попробуй спросить про 'помощь', 'физику' или 'паука'."})

@app.route('/api/register', methods=['POST'])
def register():
    data = request.json
    if User.query.filter_by(username=data['username']).first():
        return jsonify({'error': 'Этот ID уже занят!'})
    new_user = User(username=data['username'], name=data['name'], email=data['email'], password=data.get('password', '123'), avatar=data['avatar'])
    db.session.add(new_user)
    db.session.commit()
    return jsonify({'status': 'ok', 'user_id': new_user.id})

@app.route('/api/search_users', methods=['POST'])
def search_users():
    data = request.json
    query = data.get('query', '')
    users = User.query.filter((User.username.like(f'%{query}%')) | (User.name.like(f'%{query}%'))).all()
    return jsonify([{'id': u.id, 'username': u.username, 'name': u.name, 'avatar': u.avatar} for u in users])

@app.route('/api/messages/<int:user1>/<int:user2>', methods=['GET'])
def get_chat_history(user1, user2):
    msgs = Message.query.filter(
        ((Message.sender_id == user1) & (Message.receiver_id == user2)) |
        ((Message.sender_id == user2) & (Message.receiver_id == user1))
    ).order_by(Message.id.asc()).all()
    return jsonify([{'id': m.id, 'sender_id': m.sender_id, 'text': m.text} for m in msgs])

@app.route('/api/messages/send', methods=['POST'])
def send_chat_message():
    data = request.json
    
    # Если ID получателя равен 0 (это заметки), отправляем самому себе
    receiver = data['receiver_id']
    if receiver == 0:
        receiver = data['sender_id']

    new_msg = Message(sender_id=data['sender_id'], receiver_id=receiver, text=data['text'], is_read=False)
    db.session.add(new_msg)
    db.session.commit()
    return jsonify({'status': 'ok'})
@app.route('/api/messages/read', methods=['POST'])
def mark_as_read():
    data = request.json
    Message.query.filter_by(sender_id=data['from_id'], receiver_id=data['my_id']).update({"is_read": True})
    db.session.commit()
    return jsonify({'status': 'ok'})

@app.route('/api/chats/<int:my_id>', methods=['GET'])
def get_chats(my_id):
    messages = Message.query.filter((Message.sender_id == my_id) | (Message.receiver_id == my_id)).all()
    chat_ids = set()
    for m in messages:
        if m.sender_id != my_id: chat_ids.add(m.sender_id)
        if m.receiver_id != my_id: chat_ids.add(m.receiver_id)
    
    result = []
    for uid in chat_ids:
        user = db.session.get(User, uid)
        if user:
            unread = Message.query.filter_by(sender_id=uid, receiver_id=my_id, is_read=False).count() > 0
            result.append({'id': user.id, 'name': user.name, 'username': user.username, 'avatar': user.avatar, 'unread': unread})
    return jsonify(result)

