@app.route('/api/main_feed', methods=['GET'])
def main_feed():
    # Топ-3 по подписчикам
    top_users = User.query.order_by(User.subscribers.desc()).limit(3).all()
    top_list = [{'id': u.id, 'name': u.name, 'avatar': u.avatar, 'subs': u.subscribers} for u in top_users]

    # Последние 10 постов
    posts = Post.query.order_by(Post.id.desc()).limit(10).all()
    post_list = []
    for p in posts:
        u = db.session.get(User, p.user_id)
        if u:
            post_list.append({'id': p.id, 'text': p.text, 'author': u.name, 'avatar': u.avatar, 'user_id': u.id})

    # Последние 5 анкет
    anketas = Anketa.query.order_by(Anketa.id.desc()).limit(5).all()
    anketa_list = []
    for a in anketas:
        u = db.session.get(User, a.user_id)
        if u:
            anketa_list.append({'id': a.id, 'theme': a.theme, 'desc': a.description, 'author': u.name, 'avatar': u.avatar, 'user_id': u.id})

    return jsonify({'top': top_list, 'posts': post_list, 'anketas': anketa_list})

