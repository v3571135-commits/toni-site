@app.route('/api/register', methods=['POST'])
def register():
    data = request.json
    if User.query.filter_by(username=data['username']).first():
        return jsonify({'error': 'Этот ID уже занят!'})
    
    new_user = User(
        username=data['username'], 
        name=data['name'], 
        email=data['email'], 
        password=data.get('password', '123'), 
        avatar=data['avatar']
    )
    db.session.add(new_user)
    db.session.commit()
    
    return jsonify({'status': 'ok', 'user_id': new_user.id})

@app.route('/api/search_users', methods=['POST'])
def search_users():
    data = request.json
    query = data.get('query', '')
    users = User.query.filter((User.username.like(f'%{query}%')) | (User.name.like(f'%{query}%'))).all()
    return jsonify([{'id': u.id, 'username': u.username, 'name': u.name, 'avatar': u.avatar} for u in users])

@app.route('/api/messages/<int:user1>/<int:user2>', methods=['GET'])
def get_chat_history(user1, user2):
    msgs = Message.query.filter(
        ((Message.sender_id == user1) & (Message.receiver_id == user2)) |
        ((Message.sender_id == user2) & (Message.receiver_id == user1))
    ).order_by(Message.id.asc()).all()
    
    return jsonify([{
        'id': m.id,


'sender_id': m.sender_id,
        'text': m.text
    } for m in msgs])

@app.route('/api/messages/send', methods=['POST'])
def send_chat_message():
    data = request.json
    new_msg = Message(
        sender_id=data['sender_id'], 
        receiver_id=data['receiver_id'], 
        text=data['text']
    )
    db.session.add(new_msg)
    db.session.commit()
    return jsonify({'status': 'ok'})

